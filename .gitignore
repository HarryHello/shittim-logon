# Nothing in this repository is built, and nothing built belongs in it.
*.exe
*.obj
*.pdb
*.lib
*.ilk
bin/
obj/

# Assets never enter this repository -- see NOTICE.md. Listed so that an accidental
# copy into the working tree cannot be committed by reflex.
*.skel
*.atlas
*.ttf
*.otf
*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.gif

# Editors and OS
.vs/
.vscode/
Thumbs.db
desktop.ini

# macOS target: build products and the vendored spine-cpp runtime (see
# macos/spine/README.md and NOTICE.md -- the runtime is third-party and
# licensed separately; it is never distributed from this repository).
macos/build/
macos/spine/include/
macos/spine/src/
.DS_Store

# The upstream Windows source drop (1.3.0), kept locally as a reference while
# the mechanism is synced into adapter/. The real scene table and the extracted
# game assets live under it -- same policy as assets/: never committed.
shittim-logon-*-src/

# The macOS app's local config (asset paths are machine-specific; the
# committed template is macos/shittim-mac.conf.example) and the extracted
# assets directory -- same never-commit policy as above.
assets/
macos/shittim-mac.conf
