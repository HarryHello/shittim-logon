# shittim-mac.conf -- ShittimMac 的旋钮。放在运行目录下即可。
# 全部键都有默认值;不认识的键会被记进日志。

# 资产目录(包含 .skel/.atlas/.png)
assets=../assets

# 房间骨架(自包含:教室 + 坐姿角色 + 道具)
room=arona_workpage_nighttime_2

# 房间轨道:坐姿角色 Idle_NN;同伴 Idle_NN(0 = 无同伴)
idle=1
companion=11

# 前景角色骨架(B 阶段)。留空 = B 阶段停留在 A。
character=arona_spr
# 前景角色的动画名。留空 = 骨架里第一个含 Idle 的动画。
character_anim=

# 锁屏挂载开关(1 = 锁屏时全屏挂到原始锁屏之上)
sky=1

# 叠加层的天空空间层级(实测:300 及以下被锁屏遮挡,
# 320 及以上浮在锁屏全部内容——含时钟/密码框——之上)
sky_level=350

# 房间背景板的静音名单:路径含这些子串的槽位不渲染
# (逗号分隔)。默认隐藏地板和水光;系统时钟在顶部,
# 若被场景上半部盖住,把 sky,starsource 加进来。
mute_patterns=floor,waterlight,bg_sky,starsource,bg/sea,sea
